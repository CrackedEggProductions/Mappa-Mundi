[gd_resource type="Resource" script_class="TileDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://content/tiles/tile_definition.gd" id="1_tile"]

[resource]
script = ExtResource("1_tile")
definition_id = &"tile.riverside_hamlet"
display_name = "Riverside Hamlet"
placement_summary = "Existing straight River Run with an eligible Field bank. The chosen bank must face an empty square or a matching Settlement edge."
effect_summary = "Preserves the River and adds one Settlement bank with same-tile River contact. The other bank stays unchanged. Uses a normal placement and no Development slot."
tile_class = 3
unlock_act = 1
reward_class = 2
transformation_kind = &"riverside_hamlet"
transformation_placement_modes = Array[StringName]([&"occupied_square"])
transformation_prerequisite_id = &"underlying_straight_river_run"
normal_reward_copy_count = 2
presentation_id = &"transformation.riverside_hamlet"
